# Copy this file to .env.local for local `vercel dev` testing.
# In production, set these in Vercel: Project -> Settings -> Environment Variables.

# Required - your free Gemini API key from https://aistudio.google.com/apikey
# Never commit the real value.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional but recommended - lock CORS down to your GitHub Pages origin
# once you know it, e.g. https://yourusername.github.io
ALLOWED_ORIGIN=*
