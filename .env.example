# BAA production backend
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...
ALLOWED_ORIGIN=https://yourdomain.example
# Gemini backend secret (existing endpoints)
GEMINI_API_KEY=...
# Optional M43 scholarship provider. BAA never invents live scholarship data;
# provider responses must contain HTTPS source URLs before they are surfaced.
BAA_SCHOLARSHIPS_PROVIDER_URL=https://provider.example/api/scholarships
BAA_SCHOLARSHIPS_PROVIDER_TOKEN=...
